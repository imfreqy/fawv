{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketForVaultsAndDemo",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::fawvvdemobucket",
      "Condition": { "StringLike": { "s3:prefix": ["vaults/*", "demo/*"] } }
    },
    {
      "Sid": "ObjectReadWriteVaultsAndDemo",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:PutObject","s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::fawvvdemobucket/vaults/*",
        "arn:aws:s3:::fawvvdemobucket/demo/*"
      ]
    },
    {
      "Sid": "BucketMetaReads",
      "Effect": "Allow",
      "Action": ["s3:GetBucketPolicy","s3:GetEncryptionConfiguration"],
      "Resource": "arn:aws:s3:::fawvvdemobucket"
    }
  ]
}
